generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Rol {
  id_rol      Int             @id @default(autoincrement())
  nombre      String          @unique @db.VarChar(100)
  descripcion String?         @db.Text
  activo      Boolean         @default(true)
  privilegios RolPrivilegio[]
  usuarios    Usuario[]

  @@map("rol")
}

model Privilegio {
  id_privilegio Int             @id @default(autoincrement())
  nombre        String          @unique @db.VarChar(100)
  roles         RolPrivilegio[]

  @@map("privilegio")
}

model RolPrivilegio {
  id_rol        Int
  id_privilegio Int

  rol        Rol        @relation(fields: [id_rol], references: [id_rol])
  privilegio Privilegio @relation(fields: [id_privilegio], references: [id_privilegio])

  @@id([id_rol, id_privilegio])
  @@map("rol_privilegio")
}

model Departamento {
  id_departamento Int    @id @default(autoincrement())
  nombre          String @db.VarChar(255)

  municipios Municipio[]

  @@map("departamento")
}

model Municipio {
  id_municipio Int    @id @default(autoincrement())
  nombre       String @db.VarChar(255)

  id_departamento Int
  departamento    Departamento @relation(fields: [id_departamento], references: [id_departamento])

  personas Persona[]

  @@map("municipio")
}

enum EstadoCita {
  programada
  confirmada
  cancelada
  no_asistio
  atendida
  ausente
  reprogramada
}

enum Sexo {
  M
  F
}

enum CanalRecordatorio {
  WhatsApp
  SMS
  Correo
}

enum EstadoRespuesta {
  pendiente
  confirmado
  cancelado
  sin_respuesta
}

model Persona {
  id_persona         Int      @id @default(autoincrement())
  numero_identidad   String   @unique @db.Char(13)
  primer_nombre      String   @db.VarChar(50)
  segundo_nombre     String?  @db.VarChar(50)
  primer_apellido    String   @db.VarChar(50)
  segundo_apellido   String?  @db.VarChar(50)
  fecha_nacimiento   DateTime @db.Date
  telefono           String   @db.VarChar(20)
  correo_electronico String?  @unique @db.VarChar(255)
  id_municipio       Int
  direccion_linea    String?  @db.Text
  sexo               Sexo

  municipio Municipio  @relation(fields: [id_municipio], references: [id_municipio])
  usuarios  Usuario[]
  consultas Consulta[]
  citas     Cita[]

  @@map("persona")
}

model Usuario {
  id_usuario           Int     @id @default(autoincrement())
  id_persona           Int
  username             String  @unique @db.VarChar(100)
  password             String  @db.VarChar(255)
  id_rol               Int
  firma                String? @db.Text
  activo               Boolean @default(true)
  must_change_password Boolean @default(true)

  persona                Persona                @relation(fields: [id_persona], references: [id_persona])
  rol                    Rol                    @relation(fields: [id_rol], references: [id_rol])
  consultas              Consulta[]
  citas                  Cita[]
  historial_estados      EstadoHistorial[]
  movimientos_inventario MovimientoInventario[]

  @@map("usuario")
}

model AntecedentePregunta {
  id_pregunta          Int     @id @default(autoincrement())
  pregunta             String  @db.VarChar(255)
  orden_num            Int
  requiere_explicacion Boolean @default(false)

  respuestas AntecedenteRespuesta[]

  @@map("antecedente_pregunta")
}

model AntecedenteRespuesta {
  id_respuesta      Int      @id @default(autoincrement())
  id_consulta       Int
  id_pregunta       Int
  respuesta_boolean Boolean?
  explanation       String?  @db.Text

  consulta Consulta            @relation(fields: [id_consulta], references: [id_consulta])
  pregunta AntecedentePregunta @relation(fields: [id_pregunta], references: [id_pregunta])

  @@index([id_consulta])
  @@map("antecedente_respuesta")
}

model Cita {
  id_cita              Int        @id @default(autoincrement())
  id_persona           Int
  id_usuario           Int
  fecha_inicio         DateTime   @db.Timestamp()
  fecha_fin            DateTime?  @db.Timestamp()
  tipo_cita            String?    @db.VarChar(100)
  motivo               String?    @db.Text
  estado               EstadoCita @default(programada)
  recordatorio_enviado Boolean    @default(false)
  notas                String?    @db.Text

  persona           Persona           @relation(fields: [id_persona], references: [id_persona])
  doctor            Usuario           @relation(fields: [id_usuario], references: [id_usuario])
  consulta          Consulta?
  historial_estados EstadoHistorial[]
  recordatorios     Recordatorio[]

  @@map("cita")
}

model Recordatorio {
  id               Int               @id @default(autoincrement())
  id_cita          Int
  cita             Cita              @relation(fields: [id_cita], references: [id_cita])
  canal            CanalRecordatorio
  estado_respuesta EstadoRespuesta   @default(pendiente)
  fecha_envio      DateTime          @default(now())
  fecha_respuesta  DateTime?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  @@index([id_cita])
  @@map("recordatorio")
}

model Consulta {
  id_consulta           Int       @id @default(autoincrement())
  id_cita               Int?      @unique
  id_persona            Int
  id_usuario            Int
  fecha_inicio          DateTime  @db.Timestamp()
  fecha_fin             DateTime? @db.Timestamp()
  diagnostico           String?   @db.Text
  tratamiento           String?   @db.Text
  motivo                String?   @db.Text
  notas                 String?   @db.Text
  firma_paciente        String?   @db.Text
  firma_doctor_snapshot String?   @db.Text
  consentimiento        Boolean   @default(false)

  cita         Cita?                  @relation(fields: [id_cita], references: [id_cita])
  persona      Persona                @relation(fields: [id_persona], references: [id_persona])
  doctor       Usuario                @relation(fields: [id_usuario], references: [id_usuario])
  antecedentes AntecedenteRespuesta[]
  odontogramas Odontograma[]
  pagos        PagoPaciente[]

  @@map("consulta")
}

model EstadoHistorial {
  id_historial    Int         @id @default(autoincrement())
  id_cita         Int
  estado_anterior EstadoCita?
  estado_nuevo    EstadoCita
  cambiado_por    Int
  fecha_cambio    DateTime    @default(now())

  cita    Cita    @relation(fields: [id_cita], references: [id_cita], onDelete: Cascade)
  usuario Usuario @relation(fields: [cambiado_por], references: [id_usuario])

  @@index([id_cita])
  @@map("estado_historial")
}

model Diente {
  numero_diente Int     @id
  nombre        String? @db.VarChar(50)

  odontogramas Odontograma[]

  @@map("diente")
}

model Odontograma {
  id_odontograma Int     @id @default(autoincrement())
  id_consulta    Int
  id_diente      Int
  estado         String? @db.VarChar(100)
  observacion    String? @db.Text

  consulta Consulta @relation(fields: [id_consulta], references: [id_consulta])
  diente   Diente   @relation(fields: [id_diente], references: [numero_diente])

  @@unique([id_consulta, id_diente])
  @@map("odontograma")
}

model PagoPaciente {
  id_pago        Int      @id @default(autoincrement())
  id_consulta    Int
  fecha          DateTime @db.Date
  abono          Decimal  @db.Decimal(10, 2)
  observacion    String?  @db.Text
  firma_paciente String?  @db.Text

  consulta Consulta @relation(fields: [id_consulta], references: [id_consulta])

  @@map("pago_paciente")
}

enum TipoMovimiento {
  Entrada
  Salida
}

model CategoriaInsumo {
  id_categoria Int      @id @default(autoincrement())
  nombre       String   @unique @db.VarChar(100)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  insumos Insumo[]

  @@map("categoria_insumo")
}

model UnidadMedida {
  id_unidad  Int      @id @default(autoincrement())
  nombre     String   @unique @db.VarChar(100)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  insumos Insumo[]

  @@map("unidad_medida")
}

model Insumo {
  id_insumo    Int      @id @default(autoincrement())
  codigo       String   @unique @db.VarChar(50)
  nombre       String   @db.VarChar(255)
  id_categoria Int
  id_unidad    Int
  stock_actual Int      @default(0)
  stock_minimo Int      @default(0)
  precio_costo Decimal  @db.Decimal(10, 2)
  activo       Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  categoria   CategoriaInsumo        @relation(fields: [id_categoria], references: [id_categoria])
  unidad      UnidadMedida           @relation(fields: [id_unidad], references: [id_unidad])
  movimientos MovimientoInventario[]

  @@index([id_categoria])
  @@index([id_unidad])
  @@index([activo])
  @@map("insumo")
}

model MovimientoInventario {
  id_movimiento Int            @id @default(autoincrement())
  id_insumo     Int
  tipo          TipoMovimiento
  cantidad      Int
  fecha         DateTime       @default(now()) @db.Timestamp()
  id_usuario    Int
  observaciones String?        @db.Text
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  insumo  Insumo  @relation(fields: [id_insumo], references: [id_insumo])
  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_insumo])
  @@index([id_usuario])
  @@index([fecha])
  @@map("movimiento_inventario")
}
