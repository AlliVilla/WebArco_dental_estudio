generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Rol {
  id_rol      Int             @id @default(autoincrement())
  nombre      String          @unique @db.VarChar(100)
  descripcion String?         @db.Text
  activo      Boolean         @default(true)
  privilegios RolPrivilegio[]
  usuarios    Usuario[]

  @@map("rol")
}

model Privilegio {
  id_privilegio Int             @id @default(autoincrement())
  nombre        String          @unique @db.VarChar(100)
  roles         RolPrivilegio[]

  @@map("privilegio")
}

model RolPrivilegio {
  id_rol        Int
  id_privilegio Int

  rol        Rol        @relation(fields: [id_rol], references: [id_rol])
  privilegio Privilegio @relation(fields: [id_privilegio], references: [id_privilegio])

  @@id([id_rol, id_privilegio])
  @@map("rol_privilegio")
}

model Departamento {
  id_departamento Int    @id @default(autoincrement())
  nombre          String @db.VarChar(255)

  municipios Municipio[]

  @@map("departamento")
}

model Municipio {
  id_municipio Int    @id @default(autoincrement())
  nombre       String @db.VarChar(255)

  id_departamento Int
  departamento    Departamento @relation(fields: [id_departamento], references: [id_departamento])

  personas Persona[]

  @@map("municipio")
}

enum EstadoCita {
  programada
  confirmada
  cancelada
  no_asistio
  atendida
  ausente
  reprogramada
}

enum Sexo {
  M
  F
}

enum CanalRecordatorio {
  WhatsApp
  SMS
  Correo
}

enum EstadoRespuesta {
  pendiente
  confirmado
  cancelado
  sin_respuesta
  descartado
}

model Persona {
  id_persona           Int                   @id @default(autoincrement())
  numero_identidad     String                @unique @db.Char(13)
  primer_nombre        String                @db.VarChar(50)
  segundo_nombre       String?               @db.VarChar(50)
  primer_apellido      String                @db.VarChar(50)
  segundo_apellido     String?               @db.VarChar(50)
  fecha_nacimiento     DateTime              @db.Date
  telefono             String                @db.VarChar(20)
  correo_electronico   String?               @unique @db.VarChar(255)
  id_municipio         Int
  direccion_linea      String?               @db.Text
  sexo                 Sexo
  enfermedades         String?               @db.Text
  otras_enfermedades   String?               @db.Text
  medicamentos         String?               @db.Text
  alergias             String?               @db.Text
  reaccion_anestesia   String?               @db.VarChar(20)
  municipio            Municipio             @relation(fields: [id_municipio], references: [id_municipio])
  usuarios             Usuario[]
  consultas            Consulta[]
  citas                Cita[]
  tratamientosPaciente TratamientoPaciente[]

  @@map("persona")
}

model Usuario {
  id_usuario           Int     @id @default(autoincrement())
  id_persona           Int
  username             String  @unique @db.VarChar(100)
  password             String  @db.VarChar(255)
  id_rol               Int
  firma                String? @db.Text
  activo               Boolean @default(true)
  must_change_password Boolean @default(true)

  persona                Persona                @relation(fields: [id_persona], references: [id_persona])
  rol                    Rol                    @relation(fields: [id_rol], references: [id_rol])
  consultas              Consulta[]
  citas                  Cita[]
  historial_estados      EstadoHistorial[]
  movimientos_inventario MovimientoInventario[]
  cierres                Cierre[]
  egresos                Egreso[]

  egresos_creados     Egreso[] @relation("EgresoCreadoPor")
  egresos_modificados Egreso[] @relation("EgresoModificadoPor")

  @@map("usuario")
}

model ConsultaPregunta {
  id_pregunta          Int     @id @default(autoincrement())
  pregunta             String  @db.VarChar(255)
  orden_num            Int
  requiere_explicacion Boolean @default(false)
  obligatorio          Boolean @default(true)
  categoria            String  @default("Antecedentes Médicos") @db.VarChar(100)

  respuestas ConsultaRespuesta[]

  @@map("consulta_pregunta")
}

model ConsultaRespuesta {
  id_respuesta      Int      @id @default(autoincrement())
  id_consulta       Int
  id_pregunta       Int
  respuesta_boolean Boolean?
  explanation       String?  @db.Text

  consulta Consulta         @relation(fields: [id_consulta], references: [id_consulta])
  pregunta ConsultaPregunta @relation(fields: [id_pregunta], references: [id_pregunta])

  @@index([id_consulta])
  @@map("consulta_respuesta")
}

model Cita {
  id_cita              Int        @id @default(autoincrement())
  id_persona           Int
  id_usuario           Int
  fecha_inicio         DateTime   @db.Timestamp()
  fecha_fin            DateTime?  @db.Timestamp()
  tipo_cita            String?    @db.VarChar(100)
  motivo               String?    @db.Text
  estado               EstadoCita @default(programada)
  recordatorio_enviado Boolean    @default(false)
  notas                String?    @db.Text

  persona           Persona           @relation(fields: [id_persona], references: [id_persona])
  doctor            Usuario           @relation(fields: [id_usuario], references: [id_usuario])
  consulta          Consulta?
  historial_estados EstadoHistorial[]
  recordatorios     Recordatorio[]

  @@map("cita")
}

model Recordatorio {
  id               Int               @id @default(autoincrement())
  id_cita          Int
  cita             Cita              @relation(fields: [id_cita], references: [id_cita])
  canal            CanalRecordatorio
  estado_respuesta EstadoRespuesta   @default(pendiente)
  fecha_envio      DateTime          @default(now())
  fecha_respuesta  DateTime?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  @@index([id_cita])
  @@map("recordatorio")
}

model Consulta {
  id_consulta           Int       @id @default(autoincrement())
  id_cita               Int?      @unique
  id_persona            Int
  id_usuario            Int
  fecha_inicio          DateTime  @db.Timestamp()
  fecha_fin             DateTime? @db.Timestamp()
  diagnostico           String?   @db.Text
  tratamiento           String?   @db.Text
  motivo                String?   @db.Text
  notas                 String?   @db.Text
  firma_paciente        String?   @db.Text
  firma_doctor_snapshot String?   @db.Text
  consentimiento        Boolean   @default(false)
  tratamientoPacienteId Int?

  cita                Cita?                  @relation(fields: [id_cita], references: [id_cita])
  persona             Persona                @relation(fields: [id_persona], references: [id_persona])
  doctor              Usuario                @relation(fields: [id_usuario], references: [id_usuario])
  respuestas          ConsultaRespuesta[]
  odontogramas        Odontograma[]
  pagos               PagoPaciente[]
  archivos            Archivo[]
  tratamientos        Consulta_Tratamiento[]
  tratamientoPaciente TratamientoPaciente?   @relation(fields: [tratamientoPacienteId], references: [id])
  pagosConsulta       PagoConsulta[]

  @@map("consulta")
}

enum TipoArchivo {
  Tomografia
  Radiografia
  Imagen
  Antes
  Después
  Comparativa
}
model Archivo{
  id_archivo Int @id @default(autoincrement())
  id_consulta Int 
  nombre String @db.VarChar(255)
  categoria TipoArchivo
  url String @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  consulta Consulta @relation(fields: [id_consulta], references: [id_consulta])
}

model EstadoHistorial {
  id_historial    Int         @id @default(autoincrement())
  id_cita         Int
  estado_anterior EstadoCita?
  estado_nuevo    EstadoCita
  cambiado_por    Int
  fecha_cambio    DateTime    @default(now())

  cita    Cita    @relation(fields: [id_cita], references: [id_cita], onDelete: Cascade)
  usuario Usuario @relation(fields: [cambiado_por], references: [id_usuario])

  @@index([id_cita])
  @@map("estado_historial")
}

model EstadoOdontograma {
  id_estado Int    @id @default(autoincrement())
  nombre    String @unique @db.VarChar(100)
  color     String @db.VarChar(20)

  @@map("estado_odontograma")
}

model Diente {
  numero_diente Int     @id
  nombre        String? @db.VarChar(50)

  odontogramas Odontograma[]

  @@map("diente")
}

model Odontograma {
  id_odontograma     Int     @id @default(autoincrement())
  id_consulta        Int
  id_diente          Int
  estado             String? @db.VarChar(100)
  observacion        String? @db.Text
  estado_anterior    String? @db.VarChar(100)
  observacion_anterior String? @db.Text

  consulta Consulta @relation(fields: [id_consulta], references: [id_consulta])
  diente   Diente   @relation(fields: [id_diente], references: [numero_diente])

  @@unique([id_consulta, id_diente])
  @@map("odontograma")
}

model PagoPaciente {
  id_pago        Int      @id @default(autoincrement())
  id_consulta    Int
  fecha          DateTime @db.Date
  abono          Decimal  @db.Decimal(10, 2)
  observacion    String?  @db.Text
  firma_paciente String?  @db.Text
  metodo_pago    String   @default("Efectivo") @db.VarChar(50)
  estado         String   @default("Pagado") @db.VarChar(20)

  consulta Consulta @relation(fields: [id_consulta], references: [id_consulta])

  @@map("pago_paciente")
}

model Especialidad {
  id_especialidad Int      @id @default(autoincrement())
  nombre          String   @unique @db.VarChar(120)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tratamientos Tratamiento[]

  @@map("especialidad")
}

model Egreso {
  id_egreso     Int      @id @default(autoincrement())
  concepto      String   @db.VarChar(255)
  monto         Decimal  @db.Decimal(10, 2)
  categoria     String   @db.VarChar(50)
  fecha         DateTime @db.Date
  observaciones String?  @db.VarChar(255)

  id_usuario_creacion     Int
  id_usuario_modificacion Int?

  usuario_creacion     Usuario  @relation("EgresoCreadoPor", fields: [id_usuario_creacion], references: [id_usuario])
  usuario_modificacion Usuario? @relation("EgresoModificadoPor", fields: [id_usuario_modificacion], references: [id_usuario])

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  usuario           Usuario? @relation(fields: [usuarioId_usuario], references: [id_usuario])
  usuarioId_usuario Int?

  @@index([fecha])
  @@index([categoria])
  @@index([id_usuario_creacion])
  @@index([id_usuario_modificacion])
  @@map("egreso")
}

model Tratamiento {
  id_tratamiento       Int      @id @default(autoincrement())
  id_especialidad      Int
  nombre               String   @db.VarChar(150)
  descripcion          String?  @db.Text
  precio               Decimal  @db.Decimal(10, 2)
  activo               Boolean  @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  especialidad Especialidad           @relation(fields: [id_especialidad], references: [id_especialidad])
  connsultas   Consulta_Tratamiento[]

  @@map("tratamiento")
}

model Consulta_Tratamiento {
  id_consulta_tratamiento Int         @id @default(autoincrement())
  id_tratamiento          Int
  id_consulta             Int
  descuento               Int
  precio                  Decimal     @db.Decimal(10, 2)
  consulta                Consulta    @relation(fields: [id_consulta], references: [id_consulta])
  tratamiento             Tratamiento @relation(fields: [id_tratamiento], references: [id_tratamiento])

  @@map("consulta_tratamiento")
}

model CategoriaInsumo {
  id_categoria Int      @id @default(autoincrement())
  nombre       String   @unique @db.VarChar(100)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  insumos Insumo[]

  @@map("categoria_insumo")
}

model UnidadMedida {
  id_unidad  Int      @id @default(autoincrement())
  nombre     String   @unique @db.VarChar(100)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  insumos Insumo[]

  @@map("unidad_medida")
}

model Insumo {
  id_insumo    Int      @id @default(autoincrement())
  codigo       String   @unique @db.VarChar(50)
  nombre       String   @db.VarChar(255)
  id_categoria Int
  id_unidad    Int
  stock_actual Int      @default(0)
  stock_minimo Int      @default(0)
  precio_costo Decimal  @db.Decimal(10, 2)
  activo       Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  categoria   CategoriaInsumo        @relation(fields: [id_categoria], references: [id_categoria])
  unidad      UnidadMedida           @relation(fields: [id_unidad], references: [id_unidad])
  movimientos MovimientoInventario[]

  @@index([id_categoria])
  @@index([id_unidad])
  @@index([activo])
  @@map("insumo")
}

enum TipoMovimiento {
  Entrada
  Salida
}

model MovimientoInventario {
  id_movimiento Int            @id @default(autoincrement())
  id_insumo     Int
  tipo          TipoMovimiento
  cantidad      Int
  fecha         DateTime       @default(now()) @db.Timestamp()
  id_usuario    Int
  observaciones String?        @db.Text
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  insumo  Insumo  @relation(fields: [id_insumo], references: [id_insumo])
  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_insumo])
  @@index([id_usuario])
  @@index([fecha])
  @@map("movimiento_inventario")
}

model Cierre {
  id_cierre     Int        @id @default(autoincrement())
  fecha         DateTime   @default(now()) @db.Date
  tipo_cierre   TipoCierre
  ingresos      Decimal    @db.Decimal(10, 2)
  egresos       Decimal    @db.Decimal(10, 2)
  utilidad      Decimal    @db.Decimal(10, 2)
  efectivo      Decimal    @default(0.00) @db.Decimal(10, 2)
  tarjeta       Decimal    @default(0.00) @db.Decimal(10, 2)
  transferencia Decimal    @default(0.00) @db.Decimal(10, 2)
  id_usuario    Int
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_usuario])
  @@index([fecha])
  @@map("cierre")
}

enum TipoCierre {
  Diario
  Semanal
  Quincenal
  Mensual
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

enum TratamientoEstado {
  ACTIVO
  COMPLETADO
  CANCELADO
  DESACTIVADO
}

model TratamientoPaciente {
  id          Int               @id @default(autoincrement())
  pacienteId  Int
  nombre      String            @db.VarChar(200)
  costoTotal  Decimal           @db.Decimal(10, 2)
  estado      TratamientoEstado @default(ACTIVO)
  fechaInicio DateTime          @db.Date
  fechaFin    DateTime?         @db.Date
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  paciente  Persona            @relation(fields: [pacienteId], references: [id_persona])
  consultas Consulta[]
  abonos    TratamientoAbono[]

  @@map("tratamiento_paciente")
}

model PagoConsulta {
  id          Int        @id @default(autoincrement())
  consultaId  Int
  monto       Decimal    @db.Decimal(10, 2)
  metodoPago  MetodoPago @default(EFECTIVO)
  fecha       DateTime   @default(now())
  observacion String?    @db.Text

  consulta Consulta           @relation(fields: [consultaId], references: [id_consulta])
  abonos   TratamientoAbono[]

  @@map("pago_consulta")
}

model TratamientoAbono {
  id                    Int     @id @default(autoincrement())
  pagoConsultaId        Int
  tratamientoPacienteId Int
  montoAbonado          Decimal @db.Decimal(10, 2)

  pagoConsulta        PagoConsulta        @relation(fields: [pagoConsultaId], references: [id])
  tratamientoPaciente TratamientoPaciente @relation(fields: [tratamientoPacienteId], references: [id])

  @@map("tratamiento_abono")
}
